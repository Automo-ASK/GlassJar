APP_NAME=GlassJar
ENV=development

# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL — matches docker-compose defaults
DATABASE_URL=postgresql://GlassJar:GlassJar@postgres:5432/GlassJar

# Monnify — deprecated, kept dormant in case of rollback. Not used by the
# app; Flutterwave (below) is the active payment rail.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WALLET_ACCOUNT_NUMBER=

# Flutterwave v4 (OAuth2 client-credentials) — get these from your
# Flutterwave dashboard under Settings > API Keys
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
# Set under Settings > Webhooks on the Flutterwave dashboard
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Optional: pin virtual accounts to a specific bank code if the auto-assigned
# one is having issues. Leave blank to let Flutterwave auto-assign.
FLUTTERWAVE_PREFERRED_BANK_CODE=

# NVIDIA (optional, powers the treasury assistant)
NVIDIA_API_KEY=

# CORS — comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
