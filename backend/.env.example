APP_NAME=AcaFund
ENV=development

# Generate with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL — matches docker-compose defaults
DATABASE_URL=postgresql://acafund:acafund@postgres:5432/acafund

# Monnify (get all three from your Monnify merchant dashboard)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Wallet/settlement account expense payouts are debited from — required for
# the disbursement API (paying expenses out), not for collecting payments.
MONNIFY_WALLET_ACCOUNT_NUMBER=

# NVIDIA (optional, powers the treasury assistant)
NVIDIA_API_KEY=

# CORS — comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
